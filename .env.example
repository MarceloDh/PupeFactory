# Configuración general de Django
SECRET_KEY=cambiar-por-una-clave-secreta-segura
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos (sqlite3 para local / postgresql para PostgreSQL nativo)
DB_ENGINE=sqlite3
DB_NAME=pupefactory_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

